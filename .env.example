# Copy to .env and change every value before the first start.
POSTGRES_PASSWORD=change-me-long-random-string
REDIS_PASSWORD=change-me-another-long-random-string

# true in production (served over HTTPS). false only for http://localhost testing.
WAFT_COOKIE_SECURE=false

# Set to false after creating your accounts to close public registration.
WAFT_ALLOW_SIGNUP=true

# Bytes. 10 GiB per account, 2 GiB per file.
WAFT_USER_QUOTA=10737418240
WAFT_MAX_FILE_SIZE=2147483648

WAFT_HTTP_PORT=8080
